# ============================================
# StoreSight IQ - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp env.example .env

# === REQUIRED: User Must Configure ===

# Your Databricks SQL Warehouse ID
# Find in Databricks UI: SQL Warehouses > Your Warehouse > Connection Details
DATABRICKS_WAREHOUSE_ID=your_warehouse_id_here

# Ticketmaster API Key (free tier: 5000 calls/day)
# Get yours at: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here


# === SET AFTER RUNNING SETUP NOTEBOOKS ===

# Genie Space ID (created via notebook 06 / `databricks genie create-space`)
GENIE_SPACE_ID=
# Workspace/org id used to build the Genie embed iframe URL (?o=...)
WORKSPACE_ID=0000000000000000

# Lakebase (project-based) — default database inside the project
LAKEBASE_INSTANCE_NAME=storesight-refqsr-oltp
LAKEBASE_DATABASE_NAME=databricks_postgres


# === Unity Catalog Settings ===
CATALOG_NAME=your_catalog
SCHEMA_NAME=storesight_iq_refqsr


# === Model Serving Endpoints (created by notebooks 02-05) ===
DEMAND_FORECAST_ENDPOINT=storesight-refqsr-demand-forecast
LABOR_OPTIMIZER_ENDPOINT=storesight-refqsr-labor-optimizer
INVENTORY_PREDICTOR_ENDPOINT=storesight-refqsr-inventory-predictor
PREP_SCHEDULER_ENDPOINT=storesight-refqsr-prep-scheduler


# === Database Connection Pool (defaults are fine) ===
DATABRICKS_DATABASE_PORT=5432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_COMMAND_TIMEOUT=30
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE_INTERVAL=3600


# === Local Development Only ===
# These are auto-configured in Databricks Apps environment
# For local dev, the Databricks SDK uses ~/.databrickscfg automatically
# Uncomment only if you need to override:
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=your_personal_access_token





